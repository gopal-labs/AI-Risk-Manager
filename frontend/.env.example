# Frontend environment variables
# Copy this to .env.local for local development, or set in Render dashboard for production

# URL of the deployed backend API
# Local development (default — no file needed):
#   VITE_API_URL=http://localhost:8000
#
# Render production — set this in your Render static site's Environment tab:
#   VITE_API_URL=https://ai-risk-manager-api.onrender.com
VITE_API_URL=http://localhost:8000
